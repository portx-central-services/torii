# Postgres
DATABASE_URL="postgresql://torii:torii@localhost:5432/torii?schema=public"

# API
PORT=3001
HOST=0.0.0.0

# Session signing
SESSION_SECRET="change-me-32-byte-secret-string-xxxxxxxxxx"
SESSION_COOKIE_NAME="torii_sess"

# Seed
ADMIN_EMAIL="you@portx.io"
ADMIN_NAME="You"

# SSO providers (comma-separated subset of: google, okta)
AUTH_PROVIDERS="google"
ALLOWED_EMAIL_DOMAINS="portx.io"

# Google OIDC
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"

# Okta OIDC
OKTA_ISSUER=""
OKTA_CLIENT_ID=""
OKTA_CLIENT_SECRET=""
OKTA_REDIRECT_URI="http://localhost:3001/api/auth/okta/callback"

# Where to send the user after sign-in
WEB_BASE_URL="http://localhost:3000"

# Monday.com OAuth (used in Group 9)
MONDAY_CLIENT_ID=""
MONDAY_CLIENT_SECRET=""
MONDAY_REDIRECT_URI="http://localhost:3001/api/tracker/monday/callback"

# AES-256 key for token encryption at rest (32 bytes hex = 64 chars)
TRACKER_TOKEN_KEY=""
