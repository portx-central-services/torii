# Postgres
DATABASE_URL="postgresql://torii:torii@localhost:5432/torii?schema=public"

# API
PORT=3001
HOST=0.0.0.0

# Session signing
SESSION_SECRET="change-me-32-byte-secret-string-xxxxxxxxxx"
SESSION_COOKIE_NAME="torii_sess"

# Where to send the user after sign-in (web app origin)
WEB_BASE_URL="http://localhost:3000"

# Sign-in access control
# Comma-separated list of email domains that may sign in (empty = allow all, dev only).
ALLOWED_EMAIL_DOMAINS="portx.io"
# Comma-separated list of emails whose Person.isAdmin is reconciled to true on each sign-in.
ADMIN_EMAILS=""

# Keycloak OIDC (Torii's sole IdP — Google is federated upstream inside the realm)
# Full realm URL, e.g. https://auth.piam.tenants.portx.io/realms/central-services
KEYCLOAK_ISSUER=""
# Confidential client provisioned for Torii in the realm
KEYCLOAK_CLIENT_ID=""
KEYCLOAK_CLIENT_SECRET=""
# Must be listed in the Keycloak client's "Valid Redirect URIs". Use the WEB origin
# (port 3000) so the Vite dev proxy forwards the callback to the API; in prod the
# web app and API share an origin, so this is `${WEB_BASE_URL}/api/auth/keycloak/callback`.
KEYCLOAK_REDIRECT_URI="http://localhost:3000/api/auth/keycloak/callback"

# Dev-only synthetic admin session. Default false. Hard-rejected when NODE_ENV=production.
ENABLE_PREVIEW_ADMIN_BYPASS="false"

# Monday.com OAuth (per-connection, independent of Keycloak sign-in)
MONDAY_CLIENT_ID=""
MONDAY_CLIENT_SECRET=""
MONDAY_REDIRECT_URI="http://localhost:3001/api/tracker/monday/callback"

# Harvest OAuth (separate app registration at id.getharvest.com/developers)
HARVEST_CLIENT_ID=""
HARVEST_CLIENT_SECRET=""
HARVEST_REDIRECT_URI="http://localhost:3001/api/tracker/harvest/callback"

# AES-256 key for token encryption at rest (32 bytes hex = 64 chars)
TRACKER_TOKEN_KEY=""

# Sync cron toggle
ENABLE_SYNC_CRON="false"

# Anthropic API key — powers the /insights chat pane (PM-only).
# Optional outside production; the /api/insights/chat endpoint returns 503 when unset.
ANTHROPIC_API_KEY=""
# Model used by the insights chat. Defaults to claude-sonnet-4-6.
INSIGHTS_CHAT_MODEL="claude-sonnet-4-6"
