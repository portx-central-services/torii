// Torii — Prisma schema
// See openspec/changes/add-integration-dashboard/design.md for rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Phase {
  Backlog
  Initiation
  Design
  Development
  UAT
  GoLiveReadiness
  Production
}

enum ProjectState {
  OnTrack
  AtRisk
  Blocked
  Done
}

enum Role {
  PM
  Viewer
}

enum TrackerProvider {
  monday
  harvest
}

enum TrackerConnectionStatus {
  ok
  auth_failed
  rate_limited
}

enum RagLevel {
  Red
  Amber
  Green
}

enum RiskType {
  Technical
  Relationship
  Schedule
  ExternalDependency
  Gap
  Resourcing
}

enum RiskState {
  Blocked
  Inform
}

model Person {
  id                  String       @id @default(cuid())
  name                String
  email               String       @unique
  role                Role         @default(Viewer)
  defaultCapacityPct  Int          @default(100) @map("default_capacity_pct")
  isAdmin             Boolean      @default(false) @map("is_admin")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  ownedProjects       Project[]    @relation("ProjectOwner")
  allocations         Allocation[]
  sessions            Session[]
  phaseTransitions    PhaseAuditLog[]
  preference          UserPreference?
  riskUpdatesAuthored ProjectRiskUpdate[]

  @@map("people")
}

model UserPreference {
  id        String   @id @default(cuid())
  personId  String   @unique @map("person_id")
  // { hiddenProjectColumns: string[], ... } - per-user UI preferences
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Project {
  id            String       @id @default(cuid())
  name          String
  phase         Phase        @default(Backlog)
  state         ProjectState @default(OnTrack)
  // { kickoff?, target_go_live?, actual_go_live?, hypercare_end? } - ISO 8601 dates as strings
  keyDates      Json         @default("{}") @map("key_dates")
  ownerId       String?      @map("owner_id")
  // { provider, externalId } or null
  trackerRef    Json?        @map("tracker_ref")
  // Last-synced raw payload from the tracker (e.g., Monday item + column_values). Null until first sync.
  trackerRaw    Json?        @map("tracker_raw")
  // Free-form project detail fields (project_manager, core_vendor, status_report_url, ...). See PROJECT_DETAIL_KEYS.
  details       Json         @default("{}") @map("details")
  // { fieldName: "torii" | "monday" } - per-field ownership
  fieldMapping  Json         @default("{}") @map("field_mapping")
  // Optional link to a Harvest project. Unique so two Torii projects can't claim the same Harvest project.
  harvestProjectId String?   @map("harvest_project_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  owner             Person?                 @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  allocations       Allocation[]
  phaseTransitions  PhaseAuditLog[]
  riskUpdates       ProjectRiskUpdate[]
  harvestSnapshot   ProjectHarvestSnapshot?

  @@unique([harvestProjectId])
  @@map("projects")
}

model Allocation {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  personId  String   @map("person_id")
  pct       Int
  start     DateTime @db.Date
  end       DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, start, end])
  @@index([projectId, start, end])
  @@map("allocations")
}

model TrackerConnection {
  id              String                  @id @default(cuid())
  provider        TrackerProvider
  workspace       String
  accessTokenEnc  String                  @map("access_token_enc")
  refreshTokenEnc String?                 @map("refresh_token_enc")
  // Harvest sends an account ID alongside the OAuth token; required on every API call as the
  // `Harvest-Account-Id` header. Stored plaintext (it's not a secret on its own). Null for Monday.
  harvestAccountId String?                @map("harvest_account_id")
  status          TrackerConnectionStatus @default(ok)
  lastSyncedAt    DateTime?               @map("last_synced_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@unique([provider, workspace])
  @@map("tracker_connections")
}

/// Cached Harvest snapshot for a single linked project. One row per linked Torii project.
/// Hours-only by design (D9). The full Harvest API payload is retained in `raw` for debugging
/// but is never exposed by any API endpoint or UI.
model ProjectHarvestSnapshot {
  projectId             String   @id @map("project_id")
  fetchedAt             DateTime @default(now()) @map("fetched_at")
  budgetHours           Decimal? @db.Decimal(10, 2) @map("budget_hours")
  spentHoursBillable    Decimal  @default(0) @db.Decimal(10, 2) @map("spent_hours_billable")
  spentHoursNonbillable Decimal  @default(0) @db.Decimal(10, 2) @map("spent_hours_nonbillable")
  // JSON array of per-(task, person) line items. Schema enforced at the API layer
  // (HarvestSnapshotSchema with .strict() blocks any monetary keys from leaking in).
  breakdown             Json     @default("[]")
  // Raw Harvest API payload retained for debugging. Never exposed.
  raw                   Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_harvest_snapshots")
}

model PhaseAuditLog {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  fromPhase Phase    @map("from_phase")
  toPhase   Phase    @map("to_phase")
  actorId   String   @map("actor_id")
  at        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   Person  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([projectId, at])
  @@map("phase_audit_log")
}

model ProjectRiskUpdate {
  id               String     @id @default(cuid())
  projectId        String     @map("project_id")
  // Monday of the ISO week (UTC) this snapshot covers. Unique per project.
  weekOf           DateTime   @db.Date @map("week_of")
  ragLevel         RagLevel   @map("rag_level")
  riskTypes        RiskType[] @map("risk_types")
  state            RiskState
  description      String     @default("")
  goToGreenPlan    String     @default("") @map("go_to_green_plan")
  latestUpdate     String     @default("") @map("latest_update")
  nextSteps        String     @default("") @map("next_steps")
  actionRequested  String     @default("") @map("action_requested")
  authorId         String     @map("author_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt      @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  Person  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([projectId, weekOf])
  @@index([weekOf])
  @@map("project_risk_updates")
}

model Session {
  id        String   @id @default(cuid())
  personId  String   @map("person_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("sessions")
}
