// Torii — Prisma schema
// See openspec/changes/add-integration-dashboard/design.md for rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Phase {
  Backlog
  Initiation
  Design
  Development
  UAT
  GoLiveReadiness
  Production
}

enum ProjectState {
  OnTrack
  AtRisk
  Blocked
  Done
}

enum Role {
  PM
  Viewer
}

enum TrackerProvider {
  monday
  harvest
}

enum TrackerConnectionStatus {
  ok
  auth_failed
  rate_limited
}

enum RagLevel {
  Red
  Amber
  Green
}

enum RiskType {
  Technical
  Relationship
  Schedule
  ExternalDependency
  Gap
  Resourcing
}

enum RiskState {
  Blocked
  Inform
}

model Person {
  id                  String       @id @default(cuid())
  name                String
  email               String       @unique
  role                Role         @default(Viewer)
  defaultCapacityPct  Int          @default(100) @map("default_capacity_pct")
  isAdmin             Boolean      @default(false) @map("is_admin")
  /// Harvest's numeric user ID, stored as text. Bridges Torii Person rows to
  /// Harvest's per-(task, person) breakdown. Set by the upcoming Allocations ↔
  /// Actuals reconciliation work; this change only adds the column.
  harvestUserId       String?      @unique @map("harvest_user_id")
  /// Person's self-reported availability for new commitments, expressed as a
  /// percentage of their `default_capacity_pct` baseline. Edited by the person
  /// themselves (or an admin) on /people/:id. Distinct from `default_capacity_pct`,
  /// which is the part-time baseline.
  availabilityPct     Int          @default(0) @map("availability_pct")
  /// Cached sum of this person's Harvest hours in the trailing 30-day window,
  /// computed as a tail-of-sync side effect. Null when person isn't Harvest-linked
  /// or the sync hasn't computed a value yet. 0 (not null) when linked but no
  /// recent activity — distinguishes "inactive" from "no data possible."
  billedHoursLast30d  Decimal?     @db.Decimal(10, 2) @map("billed_hours_last_30d")
  /// Timestamp the `billed_hours_last_30d` value was computed. Surfaced as a
  /// "Updated <when>" tooltip on the /people index.
  billedHoursAsOf     DateTime?    @map("billed_hours_as_of")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  ownedProjects       Project[]    @relation("ProjectOwner")
  managedProjects     Project[]    @relation("ProjectManager")
  architectProjects   Project[]    @relation("SolutionArchitect")
  consultantProjects  Project[]    @relation("SolutionConsultant")
  allocations         Allocation[]
  sessions            Session[]
  phaseTransitions    PhaseAuditLog[]
  preference          UserPreference?
  riskUpdatesAuthored ProjectRiskUpdate[]
  projectCapacities   PersonProjectCapacity[]

  @@map("people")
}

/// Self-reported per-(person, project) weekly capacity. The person owns this row
/// (or an admin on their behalf): "right now I'm spending N% of my week on this
/// project." Distinct from `Allocation` (which is the PM-owned, date-ranged plan).
/// A row exists ONLY when `weeklyPct > 0`; setting it to 0 via the API removes
/// the row (see `PATCH /api/people/:id/workload`).
model PersonProjectCapacity {
  personId  String   @map("person_id")
  projectId String   @map("project_id")
  weeklyPct Int      @map("weekly_pct")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([personId, projectId])
  @@map("person_project_capacities")
}

model UserPreference {
  id        String   @id @default(cuid())
  personId  String   @unique @map("person_id")
  // { hiddenProjectColumns: string[], ... } - per-user UI preferences
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Project {
  id            String       @id @default(cuid())
  name          String
  phase         Phase        @default(Backlog)
  state         ProjectState @default(OnTrack)
  // { kickoff?, target_go_live?, actual_go_live?, hypercare_end? } - ISO 8601 dates as strings
  keyDates      Json         @default("{}") @map("key_dates")
  ownerId       String?      @map("owner_id")
  // { provider, externalId } or null
  trackerRef    Json?        @map("tracker_ref")
  // Last-synced raw payload from the tracker (e.g., Monday item + column_values). Null until first sync.
  trackerRaw    Json?        @map("tracker_raw")
  // Free-form project detail fields (project_manager, core_vendor, status_report_url, ...). See PROJECT_DETAIL_KEYS.
  details       Json         @default("{}") @map("details")
  // { fieldName: "torii" | "monday" } - per-field ownership
  fieldMapping  Json         @default("{}") @map("field_mapping")
  /// Customer that owns this delivery. Both Monday projects and Harvest projects FK into
  /// the same customer; this is the cross-system anchor. Nullable for projects whose
  /// customer hasn't been linked yet (admins map them via /trackers).
  customerId    String?      @map("customer_id")
  // Person FKs for the three role assignments. Populated by the post-extraction
  // resolver in the Monday sync. The legacy strings in `details` remain as the
  // immutable Monday-extracted history; these FKs are the canonical Torii reference.
  // Column name `solution_consultant_id` keeps storage-key consistency with the
  // existing `details.solution_consultant` JSON key (display label is "Senior Consultant").
  projectManagerId      String? @map("project_manager_id")
  solutionArchitectId   String? @map("solution_architect_id")
  solutionConsultantId  String? @map("solution_consultant_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  owner             Person?                 @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  customer          Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectManager    Person?                 @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  solutionArchitect Person?                 @relation("SolutionArchitect", fields: [solutionArchitectId], references: [id], onDelete: SetNull)
  solutionConsultant Person?                @relation("SolutionConsultant", fields: [solutionConsultantId], references: [id], onDelete: SetNull)
  allocations       Allocation[]
  phaseTransitions  PhaseAuditLog[]
  riskUpdates       ProjectRiskUpdate[]
  /// Harvest projects pinned to this Torii project (the "phase billing" case).
  /// Customer-only Harvest projects under the same customer are NOT in this relation;
  /// they live on `Customer.harvestProjects` only.
  harvestProjects   HarvestProject[]
  /// People's self-reported weekly capacity rows for this project.
  personCapacities  PersonProjectCapacity[]

  @@index([customerId])
  @@map("projects")
}

/// Cross-system customer anchor. Both Monday-sourced `Project` rows and Harvest-sourced
/// `HarvestProject` rows hang off a Customer. `harvestClientId` is the Harvest `clients`
/// resource ID — authoritative identity space for cross-system linking. Nullable for
/// Torii-only customers without a Harvest counterpart yet.
model Customer {
  id              String   @id @default(cuid())
  name            String
  harvestClientId String?  @unique @map("harvest_client_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  projects        Project[]
  harvestProjects HarvestProject[]

  @@map("customers")
}

/// Per-Harvest-project snapshot row. Replaces the previous `project_harvest_snapshots`
/// table (which was keyed 1:1 to Torii projects). Now the snapshot lives where Harvest's
/// granularity lives — on the Harvest project itself. A Harvest project belongs to
/// exactly one Customer (the cross-system anchor) and MAY be "pinned" to one Torii
/// Project (the phase-level link). When `projectId` is null, the row is customer-only
/// (typically a support project for the customer).
///
/// Hours-only by design (D9). The full Harvest API payload is retained in `raw` for
/// debugging but is never exposed by any API endpoint or UI.
model HarvestProject {
  /// Harvest's own numeric project ID, stored as text. Primary key.
  id                    String   @id
  name                  String
  customerId            String   @map("customer_id")
  /// Optional pin to a single Torii project. Admin-driven. NULL = customer-only.
  projectId             String?  @map("project_id")
  isBillable            Boolean  @default(true) @map("is_billable")
  /// Harvest URL for this project (built from workspace + harvest project id).
  harvestProjectUrl     String   @map("harvest_project_url")
  budgetHours           Decimal? @db.Decimal(10, 2) @map("budget_hours")
  spentHoursBillable    Decimal  @default(0) @db.Decimal(10, 2) @map("spent_hours_billable")
  spentHoursNonbillable Decimal  @default(0) @db.Decimal(10, 2) @map("spent_hours_nonbillable")
  // JSON array of per-(task, person) line items. Schema enforced at the API layer
  // (HarvestProjectSnapshotSchema with .strict() blocks any monetary keys from leaking in).
  breakdown             Json     @default("[]")
  /// Raw Harvest API payload retained for debugging. Never exposed.
  raw                   Json?
  fetchedAt             DateTime @default(now()) @map("fetched_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([projectId])
  @@map("harvest_projects")
}

model Allocation {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  personId  String   @map("person_id")
  pct       Int
  start     DateTime @db.Date
  end       DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, start, end])
  @@index([projectId, start, end])
  @@map("allocations")
}

model TrackerConnection {
  id              String                  @id @default(cuid())
  provider        TrackerProvider
  workspace       String
  accessTokenEnc  String                  @map("access_token_enc")
  refreshTokenEnc String?                 @map("refresh_token_enc")
  // Harvest sends an account ID alongside the OAuth token; required on every API call as the
  // `Harvest-Account-Id` header. Stored plaintext (it's not a secret on its own). Null for Monday.
  harvestAccountId String?                @map("harvest_account_id")
  status          TrackerConnectionStatus @default(ok)
  lastSyncedAt    DateTime?               @map("last_synced_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@unique([provider, workspace])
  @@map("tracker_connections")
}

model PhaseAuditLog {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  fromPhase Phase    @map("from_phase")
  toPhase   Phase    @map("to_phase")
  actorId   String   @map("actor_id")
  at        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   Person  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([projectId, at])
  @@map("phase_audit_log")
}

model ProjectRiskUpdate {
  id               String     @id @default(cuid())
  projectId        String     @map("project_id")
  // Monday of the ISO week (UTC) this snapshot covers. Unique per project.
  weekOf           DateTime   @db.Date @map("week_of")
  ragLevel         RagLevel   @map("rag_level")
  riskTypes        RiskType[] @map("risk_types")
  state            RiskState
  description      String     @default("")
  goToGreenPlan    String     @default("") @map("go_to_green_plan")
  latestUpdate     String     @default("") @map("latest_update")
  nextSteps        String     @default("") @map("next_steps")
  actionRequested  String     @default("") @map("action_requested")
  authorId         String     @map("author_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt      @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  Person  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([projectId, weekOf])
  @@index([weekOf])
  @@map("project_risk_updates")
}

model Session {
  id        String   @id @default(cuid())
  personId  String   @map("person_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("sessions")
}
